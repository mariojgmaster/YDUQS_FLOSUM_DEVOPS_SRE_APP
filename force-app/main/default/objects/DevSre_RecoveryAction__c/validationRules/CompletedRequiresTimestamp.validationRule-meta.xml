<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, 'Completed'), ISBLANK(CompletedAt__c))</errorConditionFormula>
    <errorMessage>Informe a data e hora de conclusão da ação.</errorMessage>
</ValidationRule>
