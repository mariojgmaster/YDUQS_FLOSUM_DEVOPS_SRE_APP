<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <active>true</active>
  <errorConditionFormula>AND(ISPICKVAL(CauseReviewStatus__c, "Confirmed"), ISPICKVAL(CauseType__c, "Unconfirmed"))</errorConditionFormula>
  <errorMessage>Para confirmar uma revisao, classifique primeiro a causa.</errorMessage>
</ValidationRule>
