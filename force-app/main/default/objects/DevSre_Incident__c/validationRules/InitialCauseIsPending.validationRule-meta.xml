<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>InitialCauseIsPending</fullName>
  <active>true</active>
  <errorConditionFormula>AND(ISNEW(), OR(NOT(ISPICKVAL(CauseType__c, "Unconfirmed")), NOT(ISPICKVAL(CauseReviewStatus__c, "Pending")), NOT(ISBLANK(CauseJustification__c))))</errorConditionFormula>
  <errorMessage>Novos incidentes devem iniciar com causa nao confirmada e revisao pendente.</errorMessage>
</ValidationRule>
